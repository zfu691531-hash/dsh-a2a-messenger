{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-a2a.dev/schemas/work-package/v1",
  "title": "DSH A2A Messenger Work Package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packageId", "kind", "taskId", "title", "instructions",
    "createdAt", "fileCount", "totalBytes", "files", "manifestHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["request", "result"] },
    "taskId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "instructions": { "type": "string", "maxLength": 32768 },
    "createdAt": { "type": "string", "format": "date-time" },
    "fileCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "totalBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "files": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteLength", "sha256", "mediaType", "chunkCount"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
          "chunkCount": { "type": "integer", "minimum": 0, "maximum": 342 }
        }
      }
    },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
