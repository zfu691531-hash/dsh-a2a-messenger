{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-a2a.dev/schemas/envelope/v1",
  "title": "DSH A2A Messenger encrypted envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "schemaVersion", "messageId", "conversationId",
    "senderAgentId", "senderDeviceId", "senderKeyVersion",
    "recipientDeviceIds", "createdAt", "expiresAt", "membershipEpoch",
    "keyEpoch", "senderSeq", "traceId", "correlationId", "algorithm",
    "nonce", "ciphertext", "ciphertextHash", "signature"
  ],
  "properties": {
    "protocol": { "const": "dsh-a2a-messenger/0.1" },
    "schemaVersion": { "const": 1 },
    "messageId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "senderAgentId": { "type": "string", "format": "uuid" },
    "senderDeviceId": { "type": "string", "format": "uuid" },
    "senderKeyVersion": { "type": "integer", "minimum": 1 },
    "recipientDeviceIds": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "membershipEpoch": { "type": "integer", "minimum": 1 },
    "keyEpoch": { "type": "integer", "minimum": 1 },
    "senderSeq": { "type": "integer", "minimum": 1 },
    "traceId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "algorithm": { "const": "AES-256-GCM+Ed25519" },
    "nonce": { "type": "string", "contentEncoding": "base64" },
    "ciphertext": { "type": "string", "contentEncoding": "base64", "maxLength": 349548 },
    "ciphertextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
